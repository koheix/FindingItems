{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore --staged:*)",
      "Bash(git stash list:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh repo view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Read(//C/UnityProjects/AIUEOWorld/**)",
      "Edit(Assets/Scripts/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)",
      "Write(docs/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin devel:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Edit(Assets/**/*.unity)",
      "Edit(Assets/**/*.prefab)",
      "Edit(Assets/**/*.meta)",
      "Edit(Assets/**/*.asset)",
      "Write(Assets/**/*.meta)",
      "Read(Library/**)",
      "Read(Temp/**)"
    ]
  }
}
